{
  "name": "magpie-veyra-auth",
  "version": "0.2.0",
  "description": "Magpie provider plugins for the subscriptions Veyra signs in to and magpie has no provider for: CodeBuddy (CN and Intl), LobsterAI, CodeArts and Loomy",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "page",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "codebuddy",
    "codearts",
    "lobsterai",
    "loomy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "icon": "node scripts/icon.mjs",
    "icon:check": "node scripts/icon.mjs --check"
  },
  "magpie": {
    "page": {
      "title": "Veyra accounts",
      "titles": {
        "zh": "Veyra 账号",
        "zh-TW": "Veyra 帳號"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": [
      "providers:list",
      "usage:summary"
    ],
    "options": {
      "period": "today"
    },
    "icon": "data:image/svg+xml;base64,"
  }
}
