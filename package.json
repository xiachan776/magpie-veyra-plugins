{
  "name": "magpie-veyra-auth",
  "version": "0.2.2",
  "description": "Magpie provider plugins for the subscriptions Veyra signs in to and magpie has no provider for: CodeBuddy (CN and Intl), LobsterAI, CodeArts and Loomy",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "page",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "codebuddy",
    "codearts",
    "lobsterai",
    "loomy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "icon": "node scripts/icon.mjs",
    "icon:check": "node scripts/icon.mjs --check",
    "upstream": "node scripts/upstream.mjs --dir ../new-personal",
    "upstream:check": "node scripts/upstream.mjs --dir ../new-personal --check",
    "upstream:write": "node scripts/upstream.mjs --dir ../new-personal --write"
  },
  "magpie": {
    "page": {
      "title": "Veyra accounts",
      "titles": {
        "zh": "Veyra 账号",
        "zh-TW": "Veyra 帳號"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "panels": [
      {
        "slot": "provider",
        "title": "Veyra",
        "titles": {
          "zh": "Veyra",
          "zh-TW": "Veyra"
        },
        "file": "page/provider.html"
      }
    ],
    "actions": [
      {
        "id": "veyra-accounts",
        "menu": "provider",
        "title": "Veyra: accounts and quotas",
        "titles": {
          "zh": "Veyra：账号与额度",
          "zh-TW": "Veyra：帳號與額度"
        }
      },
      {
        "id": "veyra-checkin",
        "menu": "provider",
        "title": "Veyra: check-in status",
        "titles": {
          "zh": "Veyra：签到情况",
          "zh-TW": "Veyra：簽到情況"
        }
      }
    ],
    "permissions": [
      "providers:list",
      "usage:summary"
    ],
    "options": {
      "period": "today"
    },
    "icon": "data:image/svg+xml;base64,"
  }
}
